generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  RECEPTIONIST
  PHARMACIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PaymentType {
  CONSULTATION
  APPOINTMENT
  MEDICAL_CHECKUP
  MEDICINE
  CUSTOM
}

enum PaymentStatus {
  PENDING_PAYMENT
  PAID
  PENDING_DISPENSE
  DISPENSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE_TRANSFER
  E_WALLET
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  NEW
  FOLLOW_UP
}

enum ConsultationStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum ConsultationType {
  GENERAL_CONSULTATION
  MEDICAL_CHECKUP
  FOLLOW_UP
  MINOR_INJURY
}

enum PrescriptionStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISPENSED
  REJECTED
}

enum MedicineApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryCategory {
  MEDICINE
  SUPPLEMENT
  VITAMIN
  CONTROLLED_MEDICINE
}

enum StockUnit {
  tablet
  capsule
  bottle
  tube
  sachet
  pack
  box
}

enum InventoryStockAction {
  STOCK_ADDED
  STOCK_DEDUCTED
  PRESCRIPTION_DISPENSED
  INVENTORY_APPROVED
  INVENTORY_REJECTED
  ITEM_EDITED
  ITEM_DELETED
  ITEM_RESUBMITTED
}

enum MedicalCertificateStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model User {
  userId      Int          @id @default(autoincrement())
  username    String       @unique
  passwordHash String
  role        Role
  status      UserStatus   @default(ACTIVE)
  createdAt   DateTime     @default(now())
  prescriptions Prescription[] @relation("PrescriptionDoctor")
  appointments Appointment[] @relation("AppointmentDoctor")
  consultations Consultation[] @relation("ConsultationDoctor")
  medicalCertificates MedicalCertificate[] @relation("MedicalCertificateDoctor")
  payments    Payment[]    @relation("PaymentRecorder")
  auditLogs   AuditLog[]
}

model Patient {
  patientId     Int             @id @default(autoincrement())
  name          String
  icOrPassport  String          @unique
  phone         String
  address       String?
  gender        Gender?
  dateOfBirth   DateTime?
  isActive      Boolean         @default(true)
  archivedAt    DateTime?
  archivedBy    String?
  createdAt     DateTime        @default(now())
  prescriptions Prescription[]
  appointments  Appointment[]
  consultations Consultation[]
  medicalCertificates MedicalCertificate[]
  payments      Payment[]
}

model Medicine {
  medicineId          Int                    @id @default(autoincrement())
  name                String
  category            InventoryCategory      @default(MEDICINE)
  brand               String?
  content             String?
  packaging           String?
  companyName         String?
  availableForPrescription Boolean           @default(true)
  batchNumber         String
  stockUnit           StockUnit              @default(tablet)
  quantity            Int
  expiryDate          DateTime
  price               Decimal                @db.Decimal(10,2)
  approvalStatus      MedicineApprovalStatus @default(PENDING)
  requestedById       Int?
  requestedByUsername String?
  approvedById        Int?
  approvedByUsername  String?
  approvedAt          DateTime?
  rejectedById        Int?
  rejectedByUsername  String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime               @default(now())
  prescriptionItems PrescriptionMedicine[]
  saleItems           PaymentMedicineItem[]
  stockLogs           InventoryStockLog[]

  @@unique([name, batchNumber])
  @@index([category])
  @@index([availableForPrescription])
}

model InventoryStockLog {
  logId                 Int                  @id @default(autoincrement())
  medicine              Medicine?            @relation(fields: [medicineId], references: [medicineId], onDelete: SetNull)
  medicineId            Int?
  itemName              String
  batchNumber           String
  quantityChange        Int
  actionType            InventoryStockAction
  performedById         Int?
  performedByUsername   String?
  relatedPrescriptionId Int?
  createdAt             DateTime             @default(now())

  @@index([medicineId, createdAt])
  @@index([actionType])
  @@index([relatedPrescriptionId])
}

model Prescription {
  prescriptionId Int       @id @default(autoincrement())
  patient        Patient    @relation(fields: [patientId], references: [patientId])
  patientId      Int
  doctor         User       @relation("PrescriptionDoctor", fields: [doctorId], references: [userId])
  doctorId       Int
  consultation   Consultation? @relation(fields: [consultationId], references: [consultationId])
  consultationId Int?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [appointmentId])
  appointmentId  Int?
  date           DateTime   @default(now())
  status         PrescriptionStatus @default(PENDING_VERIFICATION)
  notes          String?
  items          PrescriptionMedicine[]
  followUps      Appointment[] @relation("AppointmentPreviousPrescription")
  payment        Payment?
}

model Consultation {
  consultationId    Int                 @id @default(autoincrement())
  patient           Patient             @relation(fields: [patientId], references: [patientId])
  patientId         Int
  appointment       Appointment?        @relation(fields: [appointmentId], references: [appointmentId])
  appointmentId     Int?
  doctor            User                @relation("ConsultationDoctor", fields: [doctorId], references: [userId])
  doctorId          Int                 @default(1)
  consultationType  ConsultationType    @default(GENERAL_CONSULTATION)
  symptoms          String?
  diagnosis         String?
  consultationNotes String?
  temperature       String?
  bloodPressure     String?
  weight            String?
  height            String?
  bmi               String?
  heartRate         String?
  checkupNotes      String?
  status            ConsultationStatus  @default(WAITING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  prescription      Prescription?
  payment           Payment?
  followUpAppointments Appointment[]    @relation("ConsultationFollowUps")
  medicalCertificates MedicalCertificate[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([doctorId, status])
  @@index([createdAt])
}

model MedicalCertificate {
  medicalCertificateId Int                      @id @default(autoincrement())
  patient              Patient                  @relation(fields: [patientId], references: [patientId])
  patientId            Int
  consultation         Consultation             @relation(fields: [consultationId], references: [consultationId])
  consultationId       Int
  doctor               User                     @relation("MedicalCertificateDoctor", fields: [doctorId], references: [userId])
  doctorId             Int
  startDate            DateTime
  days                 Int
  returnToWorkDate     DateTime
  diagnosis            String
  notes                String?
  status               MedicalCertificateStatus @default(ISSUED)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([patientId, createdAt])
  @@unique([consultationId])
  @@index([doctorId])
}

model Appointment {
  appointmentId           Int                 @id @default(autoincrement())
  patient                 Patient             @relation(fields: [patientId], references: [patientId])
  patientId               Int
  doctor                  User                @relation("AppointmentDoctor", fields: [doctorId], references: [userId])
  doctorId                Int
  dateTime                DateTime
  status                  AppointmentStatus   @default(PENDING)
  type                    AppointmentType     @default(NEW)
  notes                   String?
  previousPrescription    Prescription?       @relation("AppointmentPreviousPrescription", fields: [previousPrescriptionId], references: [prescriptionId])
  previousPrescriptionId  Int?
  followUpFromConsultation Consultation?       @relation("ConsultationFollowUps", fields: [followUpFromConsultationId], references: [consultationId])
  followUpFromConsultationId Int?
  prescriptions           Prescription[]
  consultations           Consultation[]
  payment                 Payment?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([patientId])
  @@index([doctorId, dateTime])
  @@index([status])
}

model PrescriptionMedicine {
  pmId          Int          @id @default(autoincrement())
  prescription  Prescription @relation(fields: [prescriptionId], references: [prescriptionId])
  prescriptionId Int
  medicine      Medicine     @relation(fields: [medicineId], references: [medicineId])
  medicineId    Int
  dosage        String
  frequency     String
  duration      String
  qty           Int
}

model Payment {
  paymentId  Int        @id @default(autoincrement())
  patient    Patient    @relation(fields: [patientId], references: [patientId])
  patientId  Int
  recordedBy User       @relation("PaymentRecorder", fields: [recordedById], references: [userId])
  recordedById Int
  type       PaymentType
  amount     Decimal    @db.Decimal(10,2)
  consultation Consultation? @relation(fields: [consultationId], references: [consultationId])
  consultationId Int?       @unique
  prescription Prescription? @relation(fields: [prescriptionId], references: [prescriptionId])
  prescriptionId Int?       @unique
  appointment Appointment?  @relation(fields: [appointmentId], references: [appointmentId])
  appointmentId Int?        @unique
  paymentMethod PaymentMethod @default(CASH)
  remarks    String?
  date       DateTime   @default(now())
  status     PaymentStatus @default(PAID)
  dispensedAt DateTime?
  dispensedById Int?
  dispensedByUsername String?
  receipt    Receipt?
  medicineItems PaymentMedicineItem[]

  @@index([status])
  @@index([type])
  @@index([date])
}

model PaymentMedicineItem {
  itemId      Int      @id @default(autoincrement())
  payment     Payment  @relation(fields: [paymentId], references: [paymentId])
  paymentId   Int
  medicine    Medicine @relation(fields: [medicineId], references: [medicineId])
  medicineId  Int
  qty         Int
  unitPrice   Decimal  @db.Decimal(10,2)
  subtotal    Decimal  @db.Decimal(10,2)

  @@index([paymentId])
  @@index([medicineId])
}

model Receipt {
  receiptId    Int      @id @default(autoincrement())
  payment      Payment  @relation(fields: [paymentId], references: [paymentId])
  paymentId    Int      @unique
  receiptNo    String   @unique
  date         DateTime @default(now())
  totalAmount  Decimal  @db.Decimal(10,2)
}

model AuditLog {
  logId        Int      @id @default(autoincrement())
  user         User?    @relation(fields: [userId], references: [userId])
  userId       Int?
  activityType String
  timestamp    DateTime @default(now())
}
