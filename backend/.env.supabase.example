# Use the Supabase Dashboard connection string:
# Project Settings -> Database -> Connection string -> URI -> Supavisor / Pooler.
#
# Runtime/local server:
# - Prefer the Session pooler string for Prisma on a long-running Node server.
# - It usually uses port 5432 and this username format:
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Serverless/autoscaling deployments:
# - Use the Transaction pooler string, usually port 6543.
#
# Avoid using db.<project-ref>.supabase.co from networks that do not support IPv6
# or projects without the Supabase IPv4 add-on.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"
JWT_SECRET="replace_with_a_secure_random_secret"
JWT_EXPIRES_IN="1d"
PORT=4000
FRONTEND_URL="http://localhost:5173"
